# Sistema y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Archivos de bloqueo que Excel y LibreOffice crean junto a las hojas de cálculo abiertas
~$*
.~lock.*#

# Claves y entornos virtuales (las claves nunca se guardan en el repositorio)
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/

# Presentaciones: solo se publica su PDF (sin notas); los PPTX no se publican
*.pptx
*.pdf
!presentaciones/*.pdf

